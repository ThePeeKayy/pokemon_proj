# AWS Lambda-Compatible Dockerfile
# Uses public.ecr.aws/lambda/nodejs base image

FROM public.ecr.aws/lambda/nodejs:18 AS builder

RUN yum install -y \
    cmake \
    gcc-c++ \
    libcurl-devel \
    && rm -rf /var/cache/yum/*

WORKDIR /build

# Copy C++ source
COPY backend/CMakeLists.txt .
COPY backend/src/ ./src/
COPY backend/include/ ./include/

# Build C++ binary
RUN mkdir -p build && \
    cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release .. && \
    cmake --build . && \
    ls -lh pokemon-quant

# Stage 2: Lambda runtime
FROM public.ecr.aws/lambda/nodejs:18

# Install runtime libcurl
RUN yum install -y libcurl && rm -rf /var/cache/yum/*

WORKDIR ${LAMBDA_TASK_ROOT}

# Copy C++ binary
COPY --from=builder /build/build/pokemon-quant ./bin/pokemon-quant
RUN chmod +x ./bin/pokemon-quant

# Copy Node files
COPY backend/package.json .
COPY backend/lambda.js .

# Install dependencies
RUN npm ci --only=production

# Lambda handler (not Express server!)
CMD ["lambda.js.handler"]